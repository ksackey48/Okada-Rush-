def end_nitro():
    global nitro_active, nitro_end_id, nitro_release_time
    nitro_active = False
    nitro_end_id = None
    nitro_release_time = time.perf_counter()
    if running and not paused:
        update_labels()


def activate_nitro(event=None):
    global nitro_active, nitro_used_this_level, nitro_end_id, loop_id, tick_duration_s
    global nitro_start_time, nitro_release_time, nitro_trail_history
    if not running or paused or nitro_active or nitro_used_this_level:
        return
    nitro_active = True
    nitro_used_this_level = True
    nitro_start_time = time.perf_counter()
    nitro_release_time = 0.0
    nitro_trail_history = [(visual_lane, nitro_start_time)]
    if nitro_end_id is not None:
        root.after_cancel(nitro_end_id)
    nitro_end_id = root.after(3000, end_nitro)
    if loop_id is not None:
        root.after_cancel(loop_id)
    delay = current_delay()
    tick_duration_s = delay / 1000.0
    update_labels()
    draw()
    loop_id = root.after(delay, game_loop)


def start_game(event=None):
    global player_lane, visual_lane, visual_row_offset, cars, prev_cars, coins, prev_coins
    global score, level, lives, tick, running, paused, loop_id, last_tick_time, tick_duration_s
    global invincible, invincible_after_id, nitro_active, nitro_used_this_level, nitro_end_id
    global nitro_start_time, nitro_release_time, nitro_trail_history, last_level_seen

    hide_message()

    if loop_id is not None:
        root.after_cancel(loop_id)
    if invincible_after_id is not None:
        root.after_cancel(invincible_after_id)
        invincible_after_id = None
    if nitro_end_id is not None:
        root.after_cancel(nitro_end_id)
        nitro_end_id = None

    invincible = False
    nitro_active = False
    nitro_used_this_level = False
    nitro_start_time = 0.0
    nitro_release_time = 0.0
    nitro_trail_history = []
    last_level_seen = 1
    player_lane = LANES // 2
    visual_lane = float(LANES // 2)
    visual_row_offset = 1.6  # bike rolls forward onto bottom row with exhaust boost
    cars = []
    prev_cars = []
    coins = []
    prev_coins = []
    score = 0
    level = 1
    lives = START_LIVES
    tick = 0
    running = True
    paused = False
    delay = current_delay()
    tick_duration_s = delay / 1000.0
    last_tick_time = time.perf_counter()
    draw(launching=True)
    start_render_loop()
    loop_id = root.after(delay, game_loop)


def check_hits():
    """Handle the okada touching a car or a coin. Returns False if the game ended."""
    # TODO 9
    me = (player_lane, PLAYER_ROW)

    if me in coins:
        coins.remove(me)
        add_points(3)

    if me in cars and not invincible:
        cars.remove(me)
        return lose_life()

    return True


def game_loop():
    """One tick: move, remove, score, spawn, check hits, draw, schedule."""
    global cars, prev_cars, coins, prev_coins, tick, loop_id, last_tick_time, tick_duration_s
    # TODO 8: write the tick here (see the lab sheet for the 6 jobs)
    tick += 1
    last_tick_time = time.perf_counter()

    prev_cars = list(cars)
    prev_coins = list(coins)

    moved = move_down(cars)
    cars = on_road(moved)

    dodged = len(moved) - len(cars)
    add_points(dodged)

    coins = on_road(move_down(coins))

    if tick % SPAWN_EVERY == 0:
        new_cars = spawn_cars(cars_per_spawn(level))
        cars.extend(new_cars)
        if random.random() < 0.30:
            blocked_lanes = {lane for lane, _ in new_cars}
            free_lanes = [lane for lane in range(LANES) if lane not in blocked_lanes]
            if free_lanes:
                coins.append((random.choice(free_lanes), 0))

    if not check_hits():
        return

    draw()
    delay = current_delay()
    tick_duration_s = delay / 1000.0
    loop_id = root.after(delay, game_loop)


def end_invincibility():
    global invincible, invincible_after_id
    invincible = False
    invincible_after_id = None


def lose_life():
    """Take a life. Returns False if that was the last one."""
    # TODO 10
    global lives, invincible, invincible_after_id
    lives -= 1

    if lives <= 0:
        game_over()
        return False

    # # Challenge: Safe after a crash — 1.5s invincibility after losing a life
    invincible = True
    if invincible_after_id is not None:
        root.after_cancel(invincible_after_id)
    invincible_after_id = root.after(1500, end_invincibility)

    return True


def on_key(event):
    """Move the okada one lane left or right."""
    # TODO 7
    global player_lane
    step = KEYS.get(event.keysym.lower())
    if step is None or not running or paused:
        return
    player_lane = clamp_lane(player_lane + step)
    if check_hits():
        draw()


def on_space(event=None):
    if not running:
        start_game()


def toggle_pause(event=None):
    global paused, loop_id, nitro_end_id, last_tick_time
    if not running:
        return
    paused = not paused
    if paused:
        stop_render_loop()
        if loop_id is not None:
            root.after_cancel(loop_id)
            loop_id = None
        if nitro_end_id is not None:
            root.after_cancel(nitro_end_id)
            nitro_end_id = None
        draw()
        show_message("PAUSED", "Press P to continue", accent="#4fc3f7")
    else:
        hide_message()
        last_tick_time = time.perf_counter()
        if nitro_active:
            nitro_end_id = root.after(3000, end_nitro)
        start_render_loop()
        loop_id = root.after(current_delay(), game_loop)


def game_over():
    global running, high_score, loop_id, invincible, invincible_after_id, nitro_active, nitro_end_id
    running = False
    invincible = False
    nitro_active = False
    stop_render_loop()
    if invincible_after_id is not None:
        root.after_cancel(invincible_after_id)
        invincible_after_id = None
    if nitro_end_id is not None:
        root.after_cancel(nitro_end_id)
        nitro_end_id = None
    # TODO 10 (part 2): stop the game loop here
    if loop_id is not None:
        root.after_cancel(loop_id)
        loop_id = None
    draw()
    if score > high_score:
        high_score = score
        save_high_score(high_score)
        show_message("NEW HIGH SCORE!", f"You scored {score}. Space = play again", accent="#ffd600")
    else:
        show_message("GAME OVER", f"You scored {score}. Space = play again", accent="#ff5252")
    update_labels()


def animate_title():
    """Subtle gold-to-amber gleam pulse on the main title."""
    global title_anim_id
    wave = 0.5 + 0.5 * ((1.0 + math.sin(time.perf_counter() * 3.0)) * 0.5)
    fg_col = "#ffd600" if wave > 0.5 else "#ffb300"
    title_label.config(fg=fg_col)
    title_anim_id = root.after(80, animate_title)


