def draw_nitro_effects(lane_pos, row_pos):
    """Draw blue activation shockwave, streaming blue trail, status banner, and release puff."""
    global nitro_trail_history
    now = time.perf_counter()
    x, y = lane_pos * CELL, row_pos * CELL
    cx = x + CELL / 2.0
    cy = y + CELL / 2.0

    # Record trail sample while Nitro is pressed/active
    if nitro_active:
        nitro_trail_history.append((lane_pos, now))
    # Keep last 0.35s of trail samples
    nitro_trail_history = [(lp, ts) for lp, ts in nitro_trail_history if now - ts <= 0.35]

    # 1) Blue activation shockwave ring + "NITRO ENABLED!" callout when N is first pressed
    if nitro_active:
        since_press = now - nitro_start_time
        if 0.0 <= since_press <= 0.45:
            p = since_press / 0.45
            radius = 12 + p * 34
            ring_col = "#80d8ff" if p < 0.5 else "#00b0ff"
            canvas.create_oval(
                cx - radius, cy - radius, cx + radius, cy + radius,
                outline=ring_col, width=3 if p < 0.5 else 2, tags="piece"
            )
            canvas.create_rectangle(
                3, 3, WIDTH - 3, HEIGHT - 3,
                outline="#40c4ff", width=3, tags="piece"
            )

        # Floating callout above the bike for the first 1.2s after enabling Nitro
        if 0.0 <= since_press <= 1.2:
            rise = since_press * 18
            badge_y = max(24, y - 14 - rise)
            badge_cx = max(78, min(WIDTH - 78, cx))
            canvas.create_rectangle(
                badge_cx - 72, badge_y - 10, badge_cx + 72, badge_y + 10,
                fill="#062847", outline="#40c4ff", width=1.5, tags="piece"
            )
            canvas.create_text(
                badge_cx, badge_y, text="NITRO ENABLED! 2x",
                fill="#e1f5fe", font=("Consolas", 9, "bold"), tags="piece"
            )

    # 2) Multi-segment blue motion trail behind the motorbike
    for lp, ts in nitro_trail_history:
        age = now - ts
        frac = age / 0.35
        tx = lp * CELL + CELL / 2.0
        ty = (row_pos * CELL) + CELL - 4 + age * 145
        half_w = max(2.0, (1.0 - frac) * 8.0)
        if frac < 0.33:
            col = "#e1f5fe"
        elif frac < 0.66:
            col = "#40c4ff"
        else:
            col = "#0091ea"
        canvas.create_oval(
            tx - half_w, ty - half_w * 1.4, tx + half_w, ty + half_w * 1.4,
            fill=col, outline="", tags="piece"
        )

    # 3) Sharp blue jet flame + aura while Nitro is active
    if nitro_active:
        flicker = 4 * abs(((now * 24) % 2.0) - 1.0)
        canvas.create_oval(
            x + 4, y - 2, x + CELL - 4, y + CELL + 2,
            outline="#40c4ff", width=2, tags="piece"
        )
        canvas.create_polygon(
            x + 13, y + CELL - 3,
            cx, y + CELL + 18 + flicker,
            x + CELL - 13, y + CELL - 3,
            fill="#00b0ff", outline="#80d8ff", tags="piece"
        )
        canvas.create_polygon(
            x + 17, y + CELL - 3,
            cx, y + CELL + 10 + flicker * 0.5,
            x + CELL - 17, y + CELL - 3,
            fill="#e1f5fe", outline="", tags="piece"
        )

    # 4) Blue release puff when Nitro finishes and releases (0.0s -> 0.45s after end)
    if not nitro_active and nitro_release_time > 0.0:
        since_release = now - nitro_release_time
        if 0.0 <= since_release <= 0.45:
            rp = since_release / 0.45
            spread = 8 + rp * 20
            dot_r = max(1.5, (1.0 - rp) * 4.5)
            puff_col = "#80d8ff" if rp < 0.5 else "#0288d1"
            for dx, dy in [(-spread, 8), (spread, 8), (-spread * 0.6, 18), (spread * 0.6, 18)]:
                px = cx + dx
                py = y + CELL + dy * rp
                canvas.create_oval(
                    px - dot_r, py - dot_r, px + dot_r, py + dot_r,
                    fill=puff_col, outline="", tags="piece"
                )


