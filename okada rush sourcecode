def current_delay():
    delay = speed_for(level)
    return max(45, delay // 2) if nitro_active else delay


def tick_progress():
    """Return 0.0 to 1.0 showing progress through the current tick."""
    if not running or paused or tick == 0 or last_tick_time <= 0.0:
        return 1.0
    elapsed = time.perf_counter() - last_tick_time
    return max(0.0, min(1.0, elapsed / tick_duration_s))


def smooth_positions(curr_items, prev_items, frac):
    """Interpolate each (lane, row) smoothly from its previous position."""
    prev_map = {}
    for lane, row in prev_items:
        prev_map.setdefault((lane, row + 1), (lane, row))

    result = []
    for lane, row in curr_items:
        if (lane, row) in prev_map:
            p_lane, p_row = prev_map[(lane, row)]
        else:
            p_lane, p_row = lane, -1.0
        interp_row = p_row + (row - p_row) * frac
        result.append((float(lane), interp_row))
    return result


def draw_road(scroll_frac):
    """Draw road curbs and smoothly scrolling dashed lane lines."""
    canvas.delete("road")

    night = level >= 4
    curb_a = "#e53935" if not night else "#8e24aa"
    curb_b = "#ffffff" if not night else "#37474f"
    line_col = "#ffffff" if not night else "#3f6ea8"

    effective_tick = (tick - 1) + scroll_frac if running and not paused and tick > 0 else float(tick)

    # Left and right striped road curbs
    curb_period = 20
    curb_offset = (effective_tick * 10.0) % (curb_period * 2)
    for y in range(-curb_period * 2 + int(curb_offset), HEIGHT + curb_period, curb_period):
        parity = int((y - curb_offset) // curb_period) % 2
        colour = curb_a if parity == 0 else curb_b
        y1 = max(0, y)
        y2 = min(HEIGHT, y + curb_period)
        if y2 > y1:
            canvas.create_rectangle(0, y1, 6, y2, fill=colour, outline="", tags="road")
            canvas.create_rectangle(WIDTH - 6, y1, WIDTH, y2, fill=colour, outline="", tags="road")

    # Dashed lane dividers that scroll smoothly
    dash_period = 40
    offset = (effective_tick * 10.0) % dash_period
    for lane in range(1, LANES):
        x = lane * CELL
        for y in range(-dash_period + int(offset), HEIGHT + dash_period, dash_period):
            y1 = max(0, y)
            y2 = min(HEIGHT, y + 20)
            if y2 > y1:
                canvas.create_line(x, y1, x, y2, fill=line_col, width=2, tags="road")


def add_points(points):
    """Add points (doubled during active Nitro) and update level/Nitro state."""
    global score, level, nitro_used_this_level, last_level_seen
    gained = points * 2 if nitro_active else points
    score += gained
    level = level_for(score)
    if level > last_level_seen:
        last_level_seen = level
        nitro_used_this_level = False


