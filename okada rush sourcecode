def draw_animated_overlay():
    """Draw a cool sliding/pulsing banner card for start, pause, or game over."""
    canvas.delete("message")
    if not overlay_active:
        return

    elapsed = time.perf_counter() - overlay_start_time
    slide_t = min(1.0, elapsed / 0.35)
    eased = 1.0 - (1.0 - slide_t) ** 3
    y_offset = int((-180) * (1.0 - eased))

    pulse = 0.5 + 0.5 * abs(((elapsed * 2.2) % 2.0) - 1.0)
    x1 = 12
    x2 = WIDTH - 12
    y1 = HEIGHT // 2 - 64 + y_offset
    y2 = HEIGHT // 2 + 54 + y_offset

    canvas.create_rectangle(
        x1 + 4, y1 + 4, x2 + 4, y2 + 4,
        fill="#05080f", outline="", tags="message"
    )
    canvas.create_rectangle(
        x1, y1, x2, y2,
        fill="#0d1b2a", outline=overlay_accent, width=2 if pulse > 0.5 else 1, tags="message"
    )
    canvas.create_rectangle(
        x1, y1, x2, y1 + 5,
        fill=overlay_accent, outline="", tags="message"
    )

    chevron_col = "#ffd600" if pulse > 0.4 else "#90a4ae"
    canvas.create_text(x1 + 18, (y1 + y2) // 2 + 2, text="»", fill=chevron_col,
                       font=("Consolas", 16, "bold"), tags="message")
    canvas.create_text(x2 - 18, (y1 + y2) // 2 + 2, text="«", fill=chevron_col,
                       font=("Consolas", 16, "bold"), tags="message")

    canvas.create_text(
        WIDTH // 2, y1 + 38, text=overlay_title, fill=overlay_accent,
        font=("Segoe UI", 19, "bold"), tags="message"
    )
    canvas.create_text(
        WIDTH // 2, y1 + 76, text=overlay_subtitle, fill="#e0e6ed",
        font=("Segoe UI", 10), tags="message"
    )


