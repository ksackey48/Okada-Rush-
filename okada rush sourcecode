def draw(launching=False):
    """Clear the old pieces, then draw cars, coins and the okada smoothly."""
    global visual_lane, visual_row_offset
    canvas.delete("piece")

    # # Challenge: Night drive — switch road to dark blue from level 4; bright daylight below level 4
    if level >= 4:
        canvas.configure(bg="#0b1d3a")
    else:
        canvas.configure(bg="#545d66")

    frac = tick_progress()
    draw_road(frac)

    smooth_coins = smooth_positions(coins, prev_coins, frac)
    for c_lane, c_row in smooth_coins:
        x, y = c_lane * CELL, c_row * CELL
        canvas.create_oval(
            x + 10, y + 10, x + CELL - 10, y + CELL - 10,
            fill="#ffd600", outline="#ff8f00", width=2, tags="piece"
        )

    smooth_cars = smooth_positions(cars, prev_cars, frac)
    for (car_lane, _), (s_lane, s_row) in zip(cars, smooth_cars):
        draw_car(s_lane, s_row, car_lane)

    # Smooth horizontal glide toward target lane
    diff = float(player_lane) - visual_lane
    if abs(diff) < 0.03:
        visual_lane = float(player_lane)
    else:
        visual_lane += diff * 0.45

    # Smooth vertical roll-in when launching a game
    if abs(visual_row_offset) > 0.02:
        visual_row_offset *= 0.72
    else:
        visual_row_offset = 0.0

    # # Challenge: Safe after a crash — flash okada while invincible
    flash_skip = invincible and (int(time.perf_counter() * 14) % 2 == 1)
    if not flash_skip:
        draw_motorbike(
            visual_lane,
            float(PLAYER_ROW) + visual_row_offset,
            launch_boost=(launching or visual_row_offset > 0.25)
        )

    if overlay_active:
        draw_animated_overlay()

    update_labels()


