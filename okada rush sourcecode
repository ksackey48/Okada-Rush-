# ---------------- Logic functions (no GUI code here) ----------------

def move_down(items):
    """Return a new list with every (lane, row) moved one row down."""
    # TODO 1: use a list comprehension
    return [(lane, row + 1) for lane, row in items]


def on_road(items):
    """Keep only the items that are still on the road."""
    # TODO 2: a list comprehension with an if part
    return [(lane, row) for lane, row in items if row < ROWS]


def clamp_lane(lane):
    """Keep a lane number between 0 and LANES - 1."""
    # TODO 3
    return max(0, min(lane, LANES - 1))


def spawn_cars(count):
    """Return `count` new cars in different random lanes on row 0."""
    lanes = random.sample(range(LANES), count)
    return [(lane, 0) for lane in lanes]


def cars_per_spawn(level):
    """1 car per spawn at levels 1-2, 2 cars from level 3, 3 cars from level 6."""
    # TODO 6
    if level >= 6:
        return 3
    if level >= 3:
        return 2
    return 1


def level_for(score):
    """Level goes up every 10 points."""
    # TODO 4
    return score // 10 + 1


def speed_for(level):
    """Gradually speeds up by 15 ms per level, never faster than 90 ms."""
    # TODO 5
    return max(90, START_SPEED - (level - 1) * 15)


def load_high_score():
    """Read the saved high score, or 0 if there is none yet."""
    try:
        with open(HIGH_SCORE_FILE, "r") as file:
            return int(file.read().strip())
    except (FileNotFoundError, ValueError):
        return 0


def save_high_score(score):
    """Write the new high score to the file."""
    with open(HIGH_SCORE_FILE, "w") as file:
        file.write(str(score))


